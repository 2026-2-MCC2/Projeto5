# Copie este arquivo para .env e preencha com os seus dados.
# O .env nunca vai para o Git (está no .gitignore).

# Porta da API
PORT=3001

# URL do front (Vite) liberada no CORS. Para várias, separe por vírgula.
FRONT_URL=http://localhost:5173

# Banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=trocaticket

# Autenticação (JWT)
# Segredo usado para assinar os tokens: longo, aleatório e diferente em cada máquina.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_aleatorio_de_pelo_menos_32_caracteres
# Tempo até o token expirar (ex.: 30m, 8h, 7d)
JWT_EXPIRA_EM=8h
