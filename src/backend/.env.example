# Copie este arquivo para .env e preencha com os seus dados.
# O .env nunca vai para o Git (está no .gitignore).

# Porta da API
PORT=3001

# URL do front (Vite) liberada no CORS. Para várias, separe por vírgula.
FRONT_URL=http://localhost:5173

# Banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=trocaticket
